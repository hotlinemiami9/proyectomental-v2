# Public site
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_APP_VERSION=dev

# Supabase (EU project). Public values are safe for the browser.
NUXT_PUBLIC_SUPABASE_URL=
NUXT_PUBLIC_SUPABASE_ANON_KEY=
NUXT_PUBLIC_ACCOUNTS_ENABLED=false

# Server-only Supabase key. Never expose it to the client or commit it.
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# Transactional email. Configure the real secret in Coolify, never in Git.
NUXT_SMTP_HOST=
NUXT_SMTP_PORT=587
NUXT_SMTP_USER=
NUXT_SMTP_PASSWORD=
NUXT_SMTP_FROM=soporte@proyectomental.com

# Error tracking (GlitchTip, Sentry-compatible).
NUXT_PUBLIC_GLITCHTIP_DSN=

# Privacy-friendly analytics (Umami).
NUXT_PUBLIC_UMAMI_SCRIPT_URL=
NUXT_PUBLIC_UMAMI_WEBSITE_ID=

# Encrypted logical backups in Cloudflare R2 (EU jurisdiction).
NUXT_BACKUP_S3_ENDPOINT=
NUXT_BACKUP_S3_REGION=auto
NUXT_BACKUP_S3_BUCKET=
NUXT_BACKUP_S3_ACCESS_KEY_ID=
NUXT_BACKUP_S3_SECRET_ACCESS_KEY=
